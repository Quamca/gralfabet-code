{
  "expo": {
    "name": "GrAlfabet",
    "slug": "gralfabet",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["android", "ios"],
    "icon": "./assets/images/shared/gralfabet.png",
    "splash": {
      "image": "./assets/images/shared/splash-screen.png",
      "resizeMode": "cover",
      "backgroundColor": "#F9F4EC"
    },
    "android": {
      "package": "com.quamca.gralfabet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/shared/gralfabet.png",
        "backgroundColor": "#F9F4EC"
      }
    },
    "scheme": "gralfabet",
    "plugins": ["expo-router"]
  }
}
